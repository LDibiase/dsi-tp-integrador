# Copiar a .env y completar. .env NUNCA se commitea (está en .gitignore).
# cp .env.example .env

# Obligatoria: API key de OpenAI
OPENAI_API_KEY=

# Opcionales (si se dejan vacías se usan los defaults de app.py)
# Modelo a usar (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Timeout en segundos por llamada (default: 30)
OPENAI_TIMEOUT=30
# Confianza mínima para no derivar a un humano (default: 0.60)
UMBRAL_CONFIANZA=0.60
